 "missions": [
  {
   "id": "m1",
   "title": "МИССИЯ 1",
   "subtitle": "СВАЛКА",
   "shards": 1,
   "dialogs": {
    "intro": [
     {
      "who": "nell",
      "text": "Рико, это Нэлл. Рация работает, чай ещё горячий. Постарайся не сдохнуть в первые тридцать секунд, мне ставки делать."
     },
     {
      "who": "rico",
      "text": "Как трогательно. Прямо чувствую заботу."
     },
     {
      "who": "nell",
      "text": "Первый осколок у Короля Хлама. Соберёшь шесть — будешь переписывать правила этого города. Пока что ты просто полосатая мишень."
     },
     {
      "who": "rico",
      "text": "Полосатая мишень с автоматом. Важная разница."
     },
     {
      "who": "nell",
      "text": "Береги лапы. Они у тебя одни."
     },
     {
      "who": "rico",
      "text": "А остальное, видимо, уже не обязательно."
     }
    ],
    "gate": [
     {
      "who": "rico",
      "text": "Ворота были закрыты?"
     },
     {
      "who": "nell",
      "text": "Были. Теперь это «подарочный вход»."
     }
    ],
    "toxic": [
     {
      "who": "toxic",
      "text": "Не стреляй! Я на смене! Мы тут все на смене с две тысячи седьмого!"
     },
     {
      "who": "toxic",
      "text": "Барон сказал: не пьёшь за него — платишь «пивной налог». Я платил. Печень тоже платила."
     }
    ],
    "baron_pre": [
     {
      "who": "baron",
      "text": "О, свежее мясо с рацией! Сегодня наливаю я."
     },
     {
      "who": "rico",
      "text": "Как мило. А осколок ты тоже наливаешь или только болтовню?"
     },
     {
      "who": "baron",
      "text": "Это не осколок, это мой любимый штопор, щенок."
     },
     {
      "who": "rico",
      "text": "Тогда сейчас у тебя появится любимый синяк."
     }
    ],
    "baron_post": [
     {
      "who": "baron",
      "text": "Сволочь… Возьми ключ. Он открывает Ящик. Король любит ящики. Меня он тоже любит. По-королевски, то есть не очень."
     },
     {
      "who": "rico",
      "text": "Пробка-ключ? Серьёзно?"
     },
     {
      "who": "baron",
      "text": "Бар у меня один, а ключей хватает."
     }
    ],
    "crate": [
     {
      "who": "rico",
      "text": "Ящик открыт. Внутри бочка. Опять бочка."
     },
     {
      "who": "nell",
      "text": "Это не просто бочка. Стреляй в босса, а не в мебель. Мебель потом отстираем."
     }
    ],
    "king_pre": [
     {
      "who": "king",
      "text": "Мои стены. Мои колонки. Моя коллекция дерьма. А ты — экспонат номер ноль."
     },
     {
      "who": "rico",
      "text": "Экспонат номер ноль, который сейчас устроит тебе распродажу."
     },
     {
      "who": "king",
      "text": "ДИДЖЕЙ, СДЕЛАЙ ПОГРОМЧЕ!"
     },
     {
      "who": "rico",
      "text": "Да-да, погромче. Чтобы все услышали, как король орёт, когда ему прилетает."
     }
    ],
    "king_dead": [
     {
      "who": "rico",
      "text": "Осколок номер один. Прямо сложнейшая операция."
     },
     {
      "who": "nell",
      "text": "Милый… у него на спине был нарисован второй."
     },
     {
      "who": "rico",
      "text": "Конечно был. А на лбу, небось, третий."
     },
     {
      "who": "nell",
      "text": "Возвращайся, чай стынет. Следующий у свиней в Золотом Банке."
     },
     {
      "who": "rico",
      "text": "Замечательно. Надеюсь, они хотя бы не будут петь."
     }
    ]
   },
   "phase_lines": {
    "king": [
     "Мои колонки! Они стоили мне трёх мусоровозов!",
     "Всё на него! Весь хлам — на Рико!"
    ]
   },
